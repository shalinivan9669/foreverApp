{
  "name": "forever-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed:questions": "ts-node -r tsconfig-paths/register ./scripts/seedQuestions.ts",
    "seed:beta-questionnaires": "tsx ./scripts/seedBetaQuestionnaires.ts",
    "selfcheck:activity-flow": "tsx ./scripts/activity-flow.selfcheck.ts",
    "selfcheck:client-errors": "tsx ./scripts/client-errors.selfcheck.ts",
    "selfcheck:beta-questionnaires": "tsx ./scripts/beta-questionnaires.selfcheck.ts",
    "selfcheck:vectors": "tsx ./scripts/vector-scoring.selfcheck.ts",
    "selfcheck:vector-e2e": "tsx ./scripts/vector-e2e.selfcheck.ts",
    "selfcheck:pair-diagnostics": "tsx ./scripts/pair-diagnostics.selfcheck.ts",
    "selfcheck:insights-safety": "tsx ./scripts/insights-safety.selfcheck.ts",
    "selfcheck:weekly-checkin": "tsx ./scripts/weekly-checkin.selfcheck.ts",
    "selfcheck:weekly-cycle": "tsx ./scripts/weekly-cycle.selfcheck.ts",
    "selfcheck:pair-invite": "tsx ./scripts/pair-invite.selfcheck.ts",
    "selfcheck:mvp-onboarding": "tsx ./scripts/mvp-onboarding.selfcheck.ts",
    "selfcheck:pair-history": "tsx ./scripts/pair-history.selfcheck.ts",
    "selfcheck:safety-gate": "tsx ./scripts/safety-gate.selfcheck.ts",
    "selfcheck:user-profile-summary": "tsx ./scripts/user-profile-summary.selfcheck.ts",
    "selfcheck:personal-today": "tsx ./scripts/personal-today.selfcheck.ts",
    "selfcheck:pair-events": "tsx ./scripts/selfcheck-pair-events.ts",
    "selfcheck:backfill-vectors": "tsx ./scripts/backfill-vector-snapshots.selfcheck.ts",
    "selfcheck:security-critical": "tsx ./scripts/security-critical.selfcheck.ts",
    "backfill:vector-snapshots": "tsx ./scripts/backfill-vector-snapshots.ts",
    "lint": "eslint .",
    "check:lint": "npm run lint",
    "check:types": "tsc --noEmit",
    "check:build": "next build",
    "check:self": "npm run selfcheck:activity-flow && npm run selfcheck:client-errors && npm run selfcheck:beta-questionnaires && npm run selfcheck:vectors && npm run selfcheck:vector-e2e && npm run selfcheck:pair-diagnostics && npm run selfcheck:insights-safety && npm run selfcheck:weekly-checkin && npm run selfcheck:weekly-cycle && npm run selfcheck:pair-invite && npm run selfcheck:mvp-onboarding && npm run selfcheck:pair-history && npm run selfcheck:safety-gate && npm run selfcheck:user-profile-summary && npm run selfcheck:personal-today && npm run selfcheck:pair-events && npm run selfcheck:backfill-vectors && npm run selfcheck:security-critical",
    "check:agents": "tsx ./scripts/agent-checks.ts --compact",
    "check:agents:json": "tsx ./scripts/agent-checks.ts --json",
    "check:agents:changed": "tsx ./scripts/agent-checks.ts --changed-only --compact",
    "check:quick": "npm run check:types && npm run check:self && npm run check:agents"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "mongoose": "^8.24.0",
    "next": "^15.5.19",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "react-hook-form": "^7.61.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "^15.3.8",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.1.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
