{
  "name": "forever-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed:questions": "ts-node -r tsconfig-paths/register ./scripts/seedQuestions.ts",
    "selfcheck:activity-flow": "tsx ./scripts/activity-flow.selfcheck.ts",
    "selfcheck:client-errors": "tsx ./scripts/client-errors.selfcheck.ts",
    "selfcheck:vectors": "tsx ./scripts/vector-scoring.selfcheck.ts",
    "selfcheck:pair-diagnostics": "tsx ./scripts/pair-diagnostics.selfcheck.ts",
    "lint": "eslint .",
    "check:lint": "npm run lint",
    "check:types": "tsc --noEmit",
    "check:build": "next build",
    "check:self": "npm run selfcheck:activity-flow && npm run selfcheck:client-errors",
    "check:agents": "tsx ./scripts/agent-checks.ts --compact",
    "check:agents:json": "tsx ./scripts/agent-checks.ts --json",
    "check:agents:changed": "tsx ./scripts/agent-checks.ts --changed-only --compact",
    "check:quick": "npm run check:types && npm run check:self && npm run check:agents"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.0.0",
    "mongoose": "^8.17.1",
    "next": "^15.3.8",
    "next-auth": "^4.24.11",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "react-hook-form": "^7.61.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "^15.3.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
